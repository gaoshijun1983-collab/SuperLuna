{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperLuna State V7 with V8/LCRL compatibility fields",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "created_at",
    "updated_at",
    "automation",
    "policy",
    "confirmation",
    "capabilities",
    "review",
    "reviewer_chat",
    "review_history",
    "browser_reply_observation",
    "browser_binding",
    "binding",
    "attachment",
    "project_context",
    "capability_probes",
    "next_operation",
    "model_policy",
    "recovery",
    "alternative",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": 7},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "automation": {
      "type": "object",
      "required": [
        "id",
        "implementation_thread_id",
        "project_path",
        "profile",
        "retest_scope",
        "interval_minutes",
        "heartbeat_mode",
        "title",
        "waiting_check_token",
        "waiting_check_active",
        "waiting_check_kind",
        "waiting_check_account_registry",
        "waiting_check_automation_id",
        "waiting_check_claimed_id",
        "waiting_check_expected_rdate",
        "waiting_check_recovery_armed_lease_id",
        "waiting_check_recovery_armed_rdate"
      ],
      "properties": {
        "id": {"type": "string"},
        "implementation_thread_id": {"type": "string"},
        "project_path": {"type": "string"},
        "profile": {"type": "string"},
        "retest_scope": {
          "oneOf": [
            {"const": "none"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "source_checkout",
                "run_id",
                "run_root",
                "project_path",
                "state_path"
              ],
              "properties": {
                "profile": {"const": "superluna_repo_retest_v1"},
                "source_checkout": {"type": "string"},
                "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
                "run_root": {"type": "string"},
                "project_path": {"type": "string"},
                "state_path": {"type": "string"}
              }
            }
          ]
        },
        "interval_minutes": {"enum": [0, 3]},
        "heartbeat_mode": {"enum": ["foreground_only", "waiting_only", "legacy_fixed"]},
        "title": {"type": "string"},
        "waiting_check_token": {
          "type": "string",
          "description": "Identity of the single currently authorized future waiting-check occurrence; rotated before updating the stable platform heartbeat."
        },
        "waiting_check_active": {"type": "boolean"},
        "waiting_check_kind": {"enum": ["none", "review_reply", "submission_retry", "rollover_continuation"]},
        "waiting_check_account_registry": {"type": "string"},
        "waiting_check_automation_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\r\\n\\t]+$",
          "description": "Stable platform heartbeat identity for the live waiting phase; consecutive future occurrences may reuse it."
        },
        "waiting_check_claimed_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\r\\n\\t]+$",
          "description": "Platform heartbeat identity claimed by the current occurrence; cleared only by an authorized rearm or phase exit."
        },
        "waiting_check_expected_rdate": {
          "type": "string",
          "description": "Exact controller-generated single RDATE that the platform waiting task must use without rounding."
        },
        "waiting_check_recovery_armed_lease_id": {
          "type": "string",
          "description": "Current waiting-read lease whose stable platform task was confirmed at the recovery RDATE before browser access."
        },
        "waiting_check_recovery_armed_rdate": {
          "type": "string",
          "description": "Exact recovery RDATE confirmed for the currently claimed waiting-read lease; none outside that claim."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"profile": {"const": "superluna_repo_retest_v1"}},
            "required": ["profile"]
          },
          "then": {"properties": {"retest_scope": {"type": "object"}}},
          "else": {"properties": {"retest_scope": {"const": "none"}}}
        },
        {
          "if": {"properties": {"heartbeat_mode": {"const": "foreground_only"}}},
          "then": {"properties": {"interval_minutes": {"const": 0}}}
        },
        {
          "if": {"properties": {"heartbeat_mode": {"const": "waiting_only"}}},
          "then": {"properties": {"interval_minutes": {"const": 0}}}
        },
        {
          "if": {"properties": {"heartbeat_mode": {"const": "legacy_fixed"}}},
          "then": {"properties": {"interval_minutes": {"const": 3}}}
        }
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "implementation_role",
        "reviewer_kind",
        "review_quota_source",
        "codex_review_forbidden",
        "transport_locked",
        "reviewer_read_only",
        "reviewer_reasoning_required",
        "reviewer_reasoning_control"
      ],
      "properties": {
        "implementation_role": {"enum": ["luna_medium", "terra_medium"]},
        "reviewer_kind": {"const": "chatgpt"},
        "review_quota_source": {"const": "chatgpt"},
        "codex_review_forbidden": {"const": true},
        "transport_locked": {"const": true},
        "reviewer_read_only": {"const": true},
        "reviewer_reasoning_required": {"const": "extreme"},
        "reviewer_reasoning_control": {
          "enum": ["manual_app_chat", "in_app_browser"]
        }
      }
    },
    "confirmation": {
      "type": "object",
      "required": [
        "lease_id",
        "reviewer_thread_id",
        "reviewer_context_mode",
        "confirmed_at",
        "valid",
        "invalidated_reason",
        "reviewer_reasoning_mode",
        "reviewer_reasoning_confirmed",
        "reviewer_reasoning_confirmed_at",
        "reviewer_reasoning_control_source",
        "reviewer_reasoning_observed_label",
        "reviewer_reasoning_observed_thread_id",
        "reviewer_reasoning_native_app_instance_id"
      ],
      "properties": {
        "lease_id": {"type": "string"},
        "reviewer_thread_id": {"type": "string"},
        "reviewer_context_mode": {"const": "existing_chat"},
        "confirmed_at": {"type": "string"},
        "valid": {"type": "boolean"},
        "invalidated_reason": {"type": "string"},
        "reviewer_reasoning_mode": {"enum": ["unconfirmed", "extreme"]},
        "reviewer_reasoning_confirmed": {"type": "boolean"},
        "reviewer_reasoning_confirmed_at": {"type": "string"},
        "reviewer_reasoning_control_source": {"enum": ["none", "user", "main_app", "native_app", "in_app_browser"]},
        "reviewer_reasoning_observed_label": {"type": "string"},
        "reviewer_reasoning_observed_thread_id": {"type": "string"},
        "reviewer_reasoning_native_app_instance_id": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["attachment_send", "filesystem_read"],
      "properties": {
        "chat_list": {"type": "boolean"},
        "chat_read": {"type": "boolean"},
        "chat_send": {"type": "boolean"},
        "chat_create": {"type": "string"},
        "attachment_send": {"enum": ["native", "manual", "unavailable"]},
        "filesystem_read": {"enum": ["inline", "mcp_verified", "unavailable"]}
      }
    },
    "review": {
      "type": "object",
      "required": [
        "current_stage",
        "status",
        "goal_mode",
        "overall_completion_confirmed",
        "overall_completion_evidence",
        "cycle_id",
        "submission_fingerprint",
        "request_turn_id",
        "request_message_id",
        "request_persisted_at",
        "request_stage",
        "request_reasoning_mode",
        "request_native_app_instance_id",
        "response_turn_id",
        "response_message_id",
        "response_completed_at",
        "response_complete",
        "response_envelope_hash",
        "response_stage",
        "response_valid_for_apply",
        "response_quarantined_reason",
        "run_binding"
      ],
      "properties": {
        "transport": {"enum": ["app_chat_review", "in_app_browser"]},
        "goal_mode": {"enum": ["continuous", "single_stage"]},
        "overall_completion_confirmed": {"type": "boolean"},
        "overall_completion_evidence": {"type": "string"},
        "status": {
          "enum": [
            "local_work",
            "review_submit_pending",
            "review_receipt_pending",
            "review_waiting",
            "result_received",
            "result_quarantined",
            "external_blocked",
            "completed"
          ]
        },
        "cycle_id": {"type": "string"},
        "request_reasoning_mode": {"enum": ["none", "extreme", "unconfirmed", "legacy"]},
        "request_native_app_instance_id": {"type": "string"},
        "response_complete": {"type": "boolean"},
        "response_valid_for_apply": {"type": "boolean"},
        "run_binding": {
          "type": "object",
          "required": [
            "status",
            "id",
            "controller_version",
            "skill_revision",
            "state_schema_version",
            "implementation_thread_id",
            "reviewer_thread_id",
            "created_at"
          ],
          "properties": {
            "status": {"enum": ["trusted", "legacy_unrecorded"]},
            "id": {"type": "string", "pattern": "^review-run-(legacy-)?[0-9a-f]{16}$"},
            "state_schema_version": {"type": "integer"},
            "implementation_thread_id": {"type": "string"},
            "reviewer_thread_id": {"type": "string"},
            "created_at": {"type": "string"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["goal_mode", "status"],
            "properties": {
              "goal_mode": {"const": "continuous"},
              "status": {"const": "completed"}
            }
          },
          "then": {
            "required": ["overall_completion_confirmed", "overall_completion_evidence"],
            "properties": {
              "overall_completion_confirmed": {"const": true},
              "overall_completion_evidence": {"not": {"enum": ["", "none"]}}
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": {"const": "review_submit_pending"}
            }
          },
          "then": {
            "properties": {
              "response_complete": {"const": false},
              "response_valid_for_apply": {"const": false}
            }
          }
        }
      ]
    },
    "reviewer_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generation",
        "max_formal_rounds",
        "status",
        "rollover_reason",
        "rollover_authorization_id",
        "rollover_recovery_id",
        "rollover_failure_code",
        "rollover_failure_count",
        "pending_replacement",
        "retired"
      ],
      "properties": {
        "mode": {"const": "bounded_series_v1"},
        "generation": {"type": "integer", "minimum": 1},
        "max_formal_rounds": {"const": 2},
        "status": {"enum": ["active", "rollover_pending", "rollover_blocked"]},
        "rollover_reason": {"enum": ["none", "round_budget", "rate_limited"]},
        "rollover_authorization_id": {"type": "string"},
        "rollover_recovery_id": {"type": "string"},
        "rollover_failure_code": {"type": "string"},
        "rollover_failure_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "pending_replacement": {
          "oneOf": [
            {"const": "none"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "conversation_id", "conversation_url", "browser_id",
                "provider_tab_id", "observed_title", "bound_at",
                "waiting_check_automation_id"
              ],
              "properties": {
                "conversation_id": {"type": "string"},
                "conversation_url": {"type": "string"},
                "browser_id": {"type": "string"},
                "provider_tab_id": {"type": "string"},
                "observed_title": {"type": "string"},
                "bound_at": {"type": "string"},
                "waiting_check_automation_id": {"type": "string"}
              }
            }
          ]
        },
        "retired": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer_thread_id", "reason", "formal_rounds", "retired_at"],
            "properties": {
              "reviewer_thread_id": {"type": "string"},
              "reason": {"enum": ["round_budget", "rate_limited"]},
              "formal_rounds": {"type": "integer", "minimum": 0},
              "retired_at": {"type": "string"}
            }
          }
        }
      }
    },
    "review_history": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "object"}
    },
    "browser_reply_observation": {
      "type": "object",
      "required": [
        "status",
        "cycle_id",
        "request_message_id",
        "response_turn_id",
        "response_message_id",
        "response_completed_at",
        "result_file",
        "result_sha256",
        "waiting_check_automation_id",
        "waiting_read_lease_id",
        "account_slot_lease_id",
        "staged_at"
      ],
      "properties": {
        "status": {"enum": ["none", "no_complete_reply", "staged"]},
        "cycle_id": {"type": "string"},
        "request_message_id": {"type": "string"},
        "response_turn_id": {"type": "string"},
        "response_message_id": {"type": "string"},
        "response_completed_at": {"type": "string"},
        "result_file": {"type": "string"},
        "result_sha256": {"type": "string"},
        "waiting_check_automation_id": {"type": "string"},
        "waiting_read_lease_id": {"type": "string"},
        "account_slot_lease_id": {"type": "string"},
        "staged_at": {"type": "string"}
      }
    },
    "browser_binding": {
      "type": "object",
      "required": [
          "status",
          "browser_id",
          "provider_tab_id",
          "provisioned_chat",
          "conversation_id",
        "conversation_url",
        "observed_title",
        "bound_at"
      ],
      "properties": {
        "status": {"enum": ["not_applicable", "unbound", "bound"]},
        "browser_id": {
          "type": "string",
          "description": "Stable in-app browser binding identity, not a run-local tab handle."
        },
          "provider_tab_id": {
            "type": "string",
            "description": "Provider-owned tab identity used to reclaim the same user tab in a later waiting occurrence."
          },
          "provisioned_chat": {
            "type": "boolean",
            "description": "True only when this reviewer Chat was created under the current task's explicit one-time provisioning authorization."
          },
        "conversation_id": {"type": "string"},
        "conversation_url": {"type": "string"},
        "observed_title": {"type": "string"},
        "bound_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["status", "registry_path", "task_id", "display_name", "iteration", "work_status_label", "naming_template_version", "expected_work_title", "expected_chat_title", "expected_automation_title"],
      "properties": {
        "status": {"enum": ["unbound", "bound"]},
        "naming_template_version": {"enum": [1, 2, 3]}
      }
    },
    "attachment": {
      "type": "object",
      "required": ["required", "verification", "expected_names", "observed_names", "verified_at"],
      "properties": {
        "verification": {"enum": ["not_required", "unverified", "verified", "manual_confirmed", "unavailable"]},
        "expected_names": {"type": "array", "items": {"type": "string"}},
        "observed_names": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project_context": {
      "type": "object",
      "required": ["schema_version", "generation", "status", "scope", "identity", "manifest_path", "package_paths", "package_names", "package_sha256", "file_count", "total_bytes", "included_files", "uncovered_files", "reviewer_thread_id", "receipt_confirmed_at", "repository_url", "repository_identity", "commit_sha", "branch", "tree_manifest_hash", "canaries", "repository_access_receipt", "round_review", "github_access_verified", "runtime_evidence"],
      "properties": {
        "schema_version": {"const": 1},
        "generation": {"type": "integer", "minimum": 1},
        "status": {"enum": ["context_refresh_required", "partial_materials", "package_prepared", "attachment_confirmed", "github_commit_confirmed", "repository_access_receipt_required", "repository_access_confirmed", "repository_round_ready"]},
        "scope": {"enum": ["full_source", "partial", "github_commit", "repository_commit_review"]},
        "package_paths": {"type": "array", "items": {"type": "string"}},
        "package_names": {"type": "array", "items": {"type": "string"}},
        "package_sha256": {"type": "array", "items": {"type": "string"}},
        "included_files": {"type": "array", "items": {"type": "string"}},
        "uncovered_files": {"type": "array", "items": {"type": "string"}},
        "canaries": {"type": "array", "items": {"type": "object"}},
        "github_access_verified": {"type": "boolean"}
      }
    },
    "capability_probes": {
      "type": "object",
      "required": ["terra_next_turn", "attachment_upload"],
      "properties": {
        "terra_next_turn": {"enum": ["unverified", "supported", "unsupported"]},
        "attachment_upload": {
          "type": "object",
          "required": ["status", "transport", "platform_declared", "package_identity", "attempt_id", "attempt_count", "recovery_id", "recovery_used", "failure_reason", "composer_identity", "platform_receipt_id", "confirmed_at"],
          "properties": {
            "status": {"enum": ["unverified", "supported", "authorized", "blocked", "missing", "confirmed"]},
            "transport": {"enum": ["none", "direct_file_upload"]},
            "platform_declared": {"type": "boolean"},
            "package_identity": {"type": "string"},
            "attempt_id": {"type": "string"},
            "attempt_count": {"type": "integer", "minimum": 0, "maximum": 2},
            "recovery_id": {"type": "string"},
            "recovery_used": {"type": "boolean"},
            "failure_reason": {"type": "string"},
            "composer_identity": {"type": "string"},
            "platform_receipt_id": {"type": "string"},
            "confirmed_at": {"type": "string"}
          }
        }
      }
    },
    "next_operation": {
      "type": "object",
      "required": [
        "status",
        "path",
        "sha256",
        "source_response_message_id",
        "source_stage",
        "next_stage",
        "result_hash",
        "validated_at",
        "applied_at"
      ],
      "properties": {
        "status": {"enum": ["none", "validated", "applied"]}
      }
    },
    "model_policy": {
      "type": "object",
      "required": [
        "version",
        "automatic_model_switch",
        "automatic_thread_creation",
        "executor",
        "reviewer",
        "progress",
        "routing",
        "pro",
        "terra"
      ],
      "properties": {
        "version": {"const": 5},
        "automatic_model_switch": {"const": false},
        "automatic_thread_creation": {"const": false},
        "executor": {
          "type": "object",
          "required": ["default", "current"],
          "properties": {
            "default": {"enum": ["luna_medium", "terra_medium"]},
            "current": {"enum": ["luna_medium", "terra_medium"]}
          }
        },
        "reviewer": {
          "type": "object",
          "required": ["default", "current"],
          "properties": {
            "default": {"const": "sol_extreme"},
            "current": {"enum": ["sol_extreme", "chat_pro"]}
          }
        },
        "progress": {
          "type": "object",
          "required": ["active_minutes_since_pro", "meaningful_steps_since_pro", "events"],
          "properties": {
            "active_minutes_since_pro": {"type": "integer", "minimum": 0},
            "meaningful_steps_since_pro": {"type": "integer", "minimum": 0},
            "events": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "event_id",
                  "stage",
                  "active_minutes",
                  "meaningful_step",
                  "evidence_fingerprint",
                  "recorded_at"
                ],
                "properties": {
                  "event_id": {"type": "string"},
                  "stage": {"type": "string"},
                  "active_minutes": {"type": "integer", "minimum": 1, "maximum": 120},
                  "meaningful_step": {"type": "boolean"},
                  "evidence_fingerprint": {"type": "string"},
                  "recorded_at": {"type": "string"}
                }
              }
            }
          }
        },
        "routing": {"type": "object"},
        "pro": {"type": "object"},
        "terra": {"type": "object"}
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "network_state": {"enum": ["healthy", "disconnected", "recovering", "rate_limited"]},
        "network_error_count": {"type": "integer", "minimum": 0},
        "next_retry_not_before": {"type": "string"},
        "browser_consecutive_network_errors": {"type": "integer", "minimum": 0},
        "browser_consecutive_rate_limits": {"type": "integer", "minimum": 0},
        "browser_last_observation_at": {"type": "string"},
        "browser_reload_same_tab_required": {"type": "boolean"}
      }
    },
    "alternative": {
      "type": "object",
      "required": ["sent", "scope", "fingerprint"],
      "properties": {
        "sent": {"type": "boolean"},
        "scope": {"type": "string"},
        "fingerprint": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "codex_root",
        "session_log",
        "last_observed_runtime_timestamp",
        "action_lease_id",
        "action_lease_acquired_at",
        "action_lease_expires_at",
        "action_lease_reason",
        "browser_submission_reopen_browser_id",
        "browser_submission_send_authorized_lease_id",
        "browser_submission_send_authorized_account_slot_lease_id",
        "browser_submission_send_authorized_browser_id",
        "browser_submission_send_authorized_fingerprint",
        "browser_submission_send_authorized_review_run_binding_id",
        "browser_submission_send_authorized_revision"
      ],
      "properties": {
        "action_lease_id": {"type": "string"},
        "action_lease_expires_at": {"type": "string"},
        "browser_submission_reopen_browser_id": {
          "type": "string",
          "description": "Current in-app browser identity authorized by a submission-reopen lease; cleared with that lease."
        },
        "browser_submission_send_authorized_lease_id": {
          "type": "string",
          "description": "Current turn-entry or submission-reopen action lease that passed the fresh pre-send gate; cleared with that lease."
        },
        "browser_submission_send_authorized_account_slot_lease_id": {
          "type": "string",
          "description": "Live reviewer-bound submission account-slot lease proven by the fresh pre-send gate."
        },
        "browser_submission_send_authorized_browser_id": {
          "type": "string",
          "description": "Exact in-app browser identity proven by the fresh pre-send gate."
        },
        "browser_submission_send_authorized_fingerprint": {
          "type": "string",
          "description": "Exact current submission fingerprint proven by the fresh pre-send gate."
        },
        "browser_submission_send_authorized_review_run_binding_id": {
          "type": "string",
          "description": "Exact state-local review run identity rendered into the authorized payload."
        },
        "browser_submission_send_authorized_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Persisted state revision created by the fresh pre-send gate; zero when no send is authorized."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["policy"],
        "properties": {
          "policy": {
            "required": ["implementation_role"],
            "properties": {"implementation_role": {"const": "luna_medium"}}
          }
        }
      },
      "then": {
        "properties": {
          "model_policy": {
            "properties": {
              "executor": {
                "properties": {
                  "default": {"const": "luna_medium"},
                  "current": {"const": "luna_medium"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["policy"],
        "properties": {
          "policy": {
            "required": ["implementation_role"],
            "properties": {"implementation_role": {"const": "terra_medium"}}
